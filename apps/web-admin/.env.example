# PlayHub web-admin environment.
# Copy to .env.local for local dev. NEVER commit .env.local.

# Public (browser + server) — safe to expose; RLS still gates everything.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER prefixed NEXT_PUBLIC_). Used ONLY by privileged
# service-role operations in src/lib/supabase/admin.ts, each of which
# re-asserts is_super_admin() on the caller before doing anything.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
