# Supabase project credentials (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role — server-side only, never ship to mobile
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Twilio (configured in Supabase Dashboard → Auth → Providers → Phone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Gmail SMTP (configured in Supabase Dashboard → Auth → SMTP Settings)
GMAIL_SMTP_USER=noreply@yourdomain.com
GMAIL_SMTP_APP_PASSWORD=

# Razorpay — PLATFORM/FALLBACK keys. Used when an academy hasn't configured its
# own gateway (academy_payment_gateways → Supabase Vault). Per-academy merchant
# keys are entered by owners in-app and never live here.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Paytm has NO platform/fallback keys — academies bring their own (stored in
# Vault via the owner UI). Nothing to set here.

# Sentry
SENTRY_DSN_MOBILE=
SENTRY_DSN_EDGE=
